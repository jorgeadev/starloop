{
	"name": "starloop",
	"version": "1.0.0",
	"private": true,
	"description": "An engineering case study in reciprocal credit accounting, GitHub OAuth, and deliberate product constraints.",
	"license": "UNLICENSED",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=22.9.0"
	},
	"scripts": {
		"dev": "next dev",
		"dev:local": "pglite-server --db=./data/pglite --port=5433 --host=127.0.0.1 --max-connections=10 --run \"next dev\" --include-database-url",
		"db:local": "pglite-server --db=./data/pglite --port=5433 --host=127.0.0.1 --max-connections=10",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"db:studio": "drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:check": "tsx --env-file=.env.local scripts/db-check.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm test"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-select": "^2.4.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "0.45.4",
		"geist": "1.8.2",
		"lucide-react": "1.61.0",
		"next": "16.4.5",
		"postgres": "^3.4.9",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.11",
		"@electric-sql/pglite-socket": "0.2.14",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"drizzle-kit": "0.31.11",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.2",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.3",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "5.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	}
}
